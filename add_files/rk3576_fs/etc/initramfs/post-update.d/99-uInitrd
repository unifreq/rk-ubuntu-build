#!/bin/sh
set -e

version="$1"
initrd_path="$2"

real_uinitrd="/boot/uInitrd-${version}"   # 真实文件（带版本号）
link_uinitrd="/boot/uInitrd"              # 软链（不带版本号）

if dpkg -l u-boot-tools >/dev/null 2>&1 || command -v mkimage >/dev/null 2>&1; then
    echo "update-initramfs: Converting to ${real_uinitrd}" >&2

    mkimage -A arm64 -O linux -T ramdisk -C gzip -n uInitrd -d "$initrd_path" "$real_uinitrd" >/dev/null

    cd /boot && ln -sf "uInitrd-${version}" "$link_uinitrd"
fi
